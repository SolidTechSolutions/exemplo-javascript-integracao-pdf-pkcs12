# [EN]    Base URL of the SolidSign API (without trailing slash)
# [PT-BR] URL base da API SolidSign (sem barra no final)
SOLIDSIGN_API_BASE_URL=http://localhost:8080

# [EN]    Authorization header value — include "Bearer " prefix
# [PT-BR] Valor do header Authorization — inclua o prefixo "Bearer "
SOLIDSIGN_API_AUTHORIZATION=Bearer eyJ...

# [EN]    UUID of the PKCS#12 certificate previously imported via:
#         POST /solidsign/dsig/certificates/pkcs12/import
# [PT-BR] UUID do certificado PKCS#12 previamente importado via:
#         POST /solidsign/dsig/certificates/pkcs12/import
SOLIDSIGN_CERT_ID=82e227ab-8422-45a1-9936-478283c8c490

# [EN]    Input folder — only .pdf files will be processed
# [PT-BR] Pasta de entrada — apenas arquivos .pdf serão processados
SOLIDSIGN_BATCH_INPUT_PATH=C:/input_pdfs

# [EN]    Output folder where the signed ZIP will be saved
# [PT-BR] Pasta de saída onde o ZIP assinado será salvo
SOLIDSIGN_BATCH_OUTPUT_PATH=C:/signed_results

# [EN]    Signature profile: ADRB, ADRT, ADRC, ADRA, PADES_B, PADES_T, PADES_LT, PADES_LTA
# [PT-BR] Perfil de assinatura: ADRB, ADRT, ADRC, ADRA, PADES_B, PADES_T, PADES_LT, PADES_LTA
SOLIDSIGN_SIG_PROFILE=ADRB

# [EN]    Hash algorithm (SHA256, SHA384, SHA512)
# [PT-BR] Algoritmo de hash (SHA256, SHA384, SHA512)
SOLIDSIGN_SIG_HASH_ALGORITHM=SHA256

# [EN]    Optional: policy version — leave blank to use the API default
# [PT-BR] Opcional: versão da política — deixe em branco para usar o padrão da API
SOLIDSIGN_SIG_POLICY_VERSION=

# [EN]    Measurement unit for visual signature field (PIXELS or CENTIMETERS)
# [PT-BR] Unidade de medida para o campo de assinatura visual (PIXELS ou CENTIMETERS)
SOLIDSIGN_SIG_FIELD_MEASUREMENT_UNIT=PIXELS

# [EN]    Visual signature field config as JSON array (pageNumber, coordinateX, coordinateY, width, height)
# [PT-BR] Configuração do campo de assinatura visual como array JSON
SOLIDSIGN_SIG_FIELD_CONFIG=[{"pageNumber":1,"coordinateX":200,"coordinateY":380,"width":200,"height":80}]

# [EN]    Comma-separated list of signature image file paths (one per document)
# [PT-BR] Lista de caminhos de imagens separados por vírgula (uma por documento)
SOLIDSIGN_SIG_IMAGE_PATHS=C:/path/to/stamp_signature.jpeg

# [EN]    Reason for the signature
# [PT-BR] Motivo da assinatura
SOLIDSIGN_SIG_REASON=Assinatura digital

# [EN]    Signing location
# [PT-BR] Local da assinatura
SOLIDSIGN_SIG_LOCATION=Brasil

# [EN]    Contact information of the signer
# [PT-BR] Informações de contato do assinante
SOLIDSIGN_SIG_CONTACT=contato@suaempresa.com.br

PORT=8088
